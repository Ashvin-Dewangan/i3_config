{
    // This controls bar Position
    "position":"top",
    "height":35,
    "layer":"top",
    "spacing":10,
    
    "modules-left":[
        "hyprland/workspaces"
        // "applications",
        // "window/title"
    ],

    "modules-center":[
        "clock"
        // "time",
        // "date"
    ],

    "modules-right":[
        "tray",
        "cpu",
        "memory",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery"
    ],

    "clock":{
        // "format":"{:%H:%M}",
        "format":"{:%I:%M %p}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format":"{:%A %d %B}"
    },
    "battery":{
        "format":"{capacity}% 🔋",
        "interval": 60,
        "states": {
          "warning": 30,
          "critical": 15
        },
        // "format": "{capacity}% {icon}",
        // "format-icons": ["", "", "", "", ""]
    },
    "cpu":{
        "format":"CPU {}%"
    },
    "memory":{
        "format":"RAM {}%"
    },
    "network":{
        "format-wifi":"  {essid}",
        "format-disconnected":"Offline"
    },
    "pulseaudio":{
        "format":"Volume {volume}%"
    },
    "hyprland/workspaces":{
     "format": "{icon}",
     "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e+1\"})' ",
     "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({workspace=\"e-1\"})' ",
     "on-click": " hyprctl dispatch 'hl.dsp.focus({workspace={id}})'",
     // "persistent-workspaces": {
     //    "*": 5
     // }
    },
}
